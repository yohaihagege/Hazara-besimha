{% extends 'base.html.twig' %}

{% block title %}Inscription - Hazara Besimha{% endblock %}

{% block body %}
<div class="container" style="max-width: 520px;">
    <header>
        <div class="header-content">
            <h1>חזרה בשמחה</h1>
            <h2>Inscription</h2>
        </div>
    </header>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        <div class="mb-3">
            {{ form_row(registrationForm.pseudo) }}
        </div>
        <div class="mb-3">
            {{ form_row(registrationForm.email) }}
        </div>
        <div class="mb-3">
            {{ form_label(registrationForm.plainPassword, 'Mot de passe') }}
            <div style="position: relative; display: flex; align-items: center;">
                {{ form_widget(registrationForm.plainPassword, {
                    attr: {
                        class: 'form-control',
                        style: 'padding-right: 45px;'
                    }
                }) }}
                <button
                    type="button"
                    onclick="const input = this.parentElement.querySelector('input'); const isPwd = input.type === 'password'; input.type = isPwd ? 'text' : 'password'; this.setAttribute('aria-label', isPwd ? 'Masquer le mot de passe' : 'Afficher le mot de passe'); this.innerHTML = isPwd ? '🙈' : '👁️';"
                    aria-label="Afficher le mot de passe"
                    title="Afficher / masquer le mot de passe"
                    style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 4px; color: #555;"
                >👁️</button>
            </div>
            {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 25px;">
            <a href="{{ path('app_home') }}" class="btn btn-secondary btn-small" style="margin: 0; text-decoration: none;">← Retour</a>
            <button type="submit" class="btn btn-primary btn-small" style="margin: 0;">S'inscrire</button>
        </div>

        <p style="text-align: center; margin-top: 20px;">
            Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
        </p>
    {{ form_end(registrationForm) }}
</div>
{% endblock %}
