{% extends 'base.html.twig' %}

{% block title %}Hazara Besimha - Quiz de Mémorisation{% endblock %}

{% block body %}
    <div class="container">
        <header>
            <div class="header-content">
                <h1>חזרה בשמחה</h1>
                <h2 data-i18n="title">Hazara Besimha - Quiz de Mémorisation</h2>
            </div>
            <div class="header-controls">
                <div class="language-selector">
                    <label for="language-select" data-i18n="language">Langue:</label>
                    <select id="language-select" class="btn btn-small">
                        <option value="fr" data-i18n="french">Français</option>
                        <option value="he" data-i18n="hebrew">עברית</option>
                    </select>
                </div>
                
                <div id="auth-buttons" style="display: flex; gap: 10px;">
                    {% if app.user %}
                        <span id="user-email" style="align-self: center;">{{ app.user.userIdentifier }}</span>
                        <a href="{{ path('app_logout') }}" id="logout-btn" class="btn btn-small" data-i18n="logout">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" id="login-modal-btn" class="btn btn-small" data-i18n="login">Connexion</a>
                        <a href="{{ path('app_register') }}" id="register-modal-btn" class="btn btn-small" data-i18n="register">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </header>

        <!-- Écran de sélection du Seder -->
        <div id="seder-screen" class="screen active">
            <div class="selection-content">
                <h3 data-i18n="chooseSeder">Choisissez un ordre (סדר)</h3>
                <div id="sedarim-list" class="selection-list">
                    <button type="button" class="btn btn-seder" onclick="window.selectSederById && window.selectSederById('zeraim')">
                        <span class="hebrew">זרעים</span>
                        <span class="french">Semences</span>
                        <span class="description">Lois agricoles et bénédictions</span>
                    </button>
                    <button type="button" class="btn btn-seder" onclick="window.selectSederById && window.selectSederById('moed')">
                        <span class="hebrew">מועד</span>
                        <span class="french">Temps fixé</span>
                        <span class="description">Chabbat et fêtes</span>
                    </button>
                    <button type="button" class="btn btn-seder" onclick="window.selectSederById && window.selectSederById('nashim')">
                        <span class="hebrew">נשים</span>
                        <span class="french">Femmes</span>
                        <span class="description">Lois familiales et mariage</span>
                    </button>
                    <button type="button" class="btn btn-seder" onclick="window.selectSederById && window.selectSederById('nezikin')">
                        <span class="hebrew">נזיקין</span>
                        <span class="french">Dommages</span>
                        <span class="description">Droit civil et pénal</span>
                    </button>
                    <button type="button" class="btn btn-seder" onclick="window.selectSederById && window.selectSederById('kodashim')">
                        <span class="hebrew">קדשים</span>
                        <span class="french">Choses saintes</span>
                        <span class="description">Lois du Temple et sacrifices</span>
                    </button>
                    <button type="button" class="btn btn-seder" onclick="window.selectSederById && window.selectSederById('tohorot')">
                        <span class="hebrew">טהרות</span>
                        <span class="french">Puretés</span>
                        <span class="description">Lois de pureté rituelle</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Écran de sélection du traité -->
        <div id="massekhet-screen" class="screen">
            <div class="selection-content">
                <h3 data-i18n="chooseMassekhet">Choisissez un traité (מסכת)</h3>
                <button id="back-to-seder" class="btn btn-secondary" data-i18n="backToSeder">← Retour aux ordres</button>
                <div id="massekhot-list" class="selection-list">
                    <p style="text-align: center; color: #999;" data-i18n="loading">Chargement des traités...</p>
                </div>
            </div>
        </div>

        <!-- Écran de sélection du chapitre -->
        <div id="perek-screen" class="screen">
            <div class="selection-content">
                <h3 id="perek-title" data-i18n="choosePerek">Choisissez un chapitre (פרק)</h3>
                <button id="back-to-massekhet" class="btn btn-secondary" data-i18n="backToMassekhet">← Retour aux traités</button>
                <div id="perakim-list" class="selection-list"></div>
            </div>
        </div>

        <!-- Écran de sélection du daf -->
        <div id="daf-screen" class="screen">
            <div class="selection-content">
                <h3 id="daf-title" data-i18n="chooseDaf">Choisissez un daf (דף)</h3>
                <button id="back-to-perek" class="btn btn-secondary" data-i18n="backToPerek">← Retour aux chapitres</button>
                <div id="dapim-list" class="selection-list"></div>
            </div>
        </div>

        <!-- Écran du quiz -->
        <div id="quiz-screen" class="screen">
            <div class="quiz-header">
                <div class="quiz-breadcrumb">
                    <span id="current-seder-name"></span> > 
                    <span id="current-massekhet-name"></span> > 
                    <span id="current-perek-name"></span> > 
                    <span id="current-daf-name"></span>
                </div>
                <div class="quiz-top-actions" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 15px;">
                    <button id="back-to-daf" class="btn btn-small" style="margin: 0;" data-i18n="backToDaf">← Retour</button>
                    <div class="daf-yomi-controls" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                        <a id="daf-yomi-link" href="https://daf-yomi.com/dafYomi.aspx" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-small" style="margin: 0; text-decoration: none;" data-i18n="viewOnDafYomi">📖 Étudier ce Daf sur daf-yomi.com</a>
                        <button id="regenerate-questions-btn" type="button" class="btn btn-secondary btn-small" style="margin: 0;" data-i18n="regenerateQuestions">🔄 Nouvelles questions (daf-yomi.com)</button>
                    </div>
                </div>
                <div class="progress-bar">
                    <div id="progress" class="progress-fill"></div>
                </div>
                <div class="quiz-info">
                    <span id="question-number">Question 1</span>
                    <span id="score">Score: 0</span>
                </div>
            </div>

            <div id="quiz-loading" class="quiz-loading" style="display: none; text-align: center; padding: 40px 20px;">
                <div class="spinner-border" style="color: var(--gold); width: 3rem; height: 3rem; margin-bottom: 15px;" role="status"></div>
                <p id="quiz-loading-text" style="font-size: 1.3em; color: var(--navy); font-weight: 600;" data-i18n="loadingDafQuestions">Récupération du Daf sur daf-yomi.com et génération des questions...</p>
            </div>

            <div id="quiz-body-content">
                <div class="question-container">
                    <div id="question-text" class="question-text"></div>
                    <div id="question-type" class="question-type"></div>
                </div>

                <div id="answers-container" class="answers-container"></div>

                <div id="feedback" class="feedback"></div>

                <div class="quiz-actions">
                    <button id="submit-btn" class="btn btn-primary" disabled data-i18n="submit">Valider</button>
                    <button id="next-btn" class="btn btn-secondary" style="display: none;" data-i18n="nextQuestion">Question Suivante</button>
                    <button id="finish-btn" class="btn btn-secondary" style="display: none;" data-i18n="finishQuiz">Terminer le Quiz</button>
                </div>
            </div>
        </div>

        <!-- Écran de résultats -->
        <div id="results-screen" class="screen">
            <div class="results-content">
                <h2 data-i18n="resultsTitle">Résultats du Quiz</h2>
                <div class="score-display">
                    <div class="score-circle">
                        <span id="final-score">0</span>
                        <span class="score-label">%</span>
                    </div>
                    <p id="score-message"></p>
                </div>
                <div class="results-details">
                    <p><span data-i18n="correctAnswers">Bonnes réponses:</span> <span id="correct-count">0</span></p>
                    <p><span data-i18n="incorrectAnswers">Mauvaises réponses:</span> <span id="incorrect-count">0</span></p>
                    <p><span data-i18n="totalQuestions">Total:</span> <span id="total-questions">0</span> <span data-i18n="questions">questions</span></p>
                </div>
                <div class="results-actions">
                    <button id="retry-daf-btn" class="btn btn-primary" data-i18n="retryDaf">Réviser ce daf à nouveau</button>
                    <button id="new-selection-btn" class="btn btn-secondary" data-i18n="newSelection">Choisir un autre daf</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
